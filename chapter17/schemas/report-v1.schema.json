{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/chapter17/report-v1.schema.json",
  "title": "Chapter 17 offline evidence report",
  "type": "object",
  "required": ["schema_version", "groups", "summary", "source_proof", "limits"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "chapter17.multimodal.v1"},
    "groups": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"type": "object", "required": ["id", "title", "cases"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "integer", "minimum": 1, "maximum": 5},
          "title": {"type": "string", "minLength": 1},
          "cases": {"type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["id", "status", "value", "reasons", "evidence_ids", "details", "security_violation"],
              "additionalProperties": false,
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "status": {"enum": ["answer", "unknown", "blocked", "refresh"]},
                "value": {"type": ["string", "null"]},
                "reasons": {"type": "array", "items": {"type": "string"}},
                "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
                "details": {"type": "object"},
                "security_violation": {"type": "boolean"}
              }}
          }
        }}
    },
    "summary": {"type": "object", "required": ["cases_total", "answers", "unknown", "blocked", "refresh", "security_violations", "evidence_covered", "evidence_total"],
      "additionalProperties": false,
      "properties": {
        "cases_total": {"type": "integer", "minimum": 0},
        "answers": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "refresh": {"type": "integer", "minimum": 0},
        "security_violations": {"type": "integer", "minimum": 0},
        "evidence_covered": {"type": "integer", "minimum": 0},
        "evidence_total": {"type": "integer", "minimum": 0}
      }},
    "source_proof": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "limits": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
